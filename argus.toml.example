# Argus configuration
listen = "127.0.0.1:8443"
# Public issuer URL (browser-facing, behind nginx TLS)
external_url = "https://id.rajeev.me"
database = "/var/lib/argus/argus.db"

# Signing key (auto-generated on first boot if missing)
signing_key_pem_path = "/etc/argus/signing-key.pem"

access_token_ttl = 3600
session_ttl = 43200

# GitHub OAuth app (env GITHUB_CLIENT_ID / GITHUB_CLIENT_SECRET override)
github_client_id = ""
github_client_secret = ""

# First account with this email is auto-promoted to admin
bootstrap_admin_email = "rajeev@rajeev.me"
